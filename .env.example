# Copy this file to .env and fill in real values before `docker compose up -d`.
# .env is gitignored - never commit real credentials.

# Postgres (also used by the app container to connect - see docker-compose.yml)
POSTGRES_PASSWORD=change-me

# iphoto admin account (see application.yml's admin.username/admin.password default of
# admin/admin - MUST be overridden for a real deployment)
IPHOTO_ADMIN_USERNAME=admin
IPHOTO_ADMIN_PASSWORD=change-me

# Which published image tag to deploy - "latest" tracks master, or pin a specific
# ghcr.io/georgeslb/iphoto:sha-xxxxxxx tag (see .github/workflows/docker-image.yml)
IPHOTO_TAG=latest

# Host port the app is published on
IPHOTO_PORT=8080
