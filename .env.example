# Copy this file to .env and fill in real values before `docker compose up -d`.
# .env is gitignored - never commit real credentials.

# Postgres (also used by the app container to connect - see docker-compose.yml)
POSTGRES_PASSWORD=change-me

# iphoto admin account password (username is fixed at "admin", not configurable here - see
# application.yml's admin.username). Reconciled on every boot now, not just the account's
# first-ever creation - changing this and restarting the app container is enough to actually
# change it, even against an existing database.
IPHOTO_ADMIN_PASSWORD=change-me

# Signs the "remember me" persistent-login cookie (see application.yml's iphoto.security.
# remember-me-key) - a real secret, not a password anyone types in. Generate one with e.g.
# `openssl rand -hex 32`. Changing it later invalidates every outstanding remember-me cookie.
IPHOTO_REMEMBER_ME_KEY=change-me

# Which published image tag to deploy - "latest" tracks master, or pin a specific
# ghcr.io/georgeslb/iphoto:sha-xxxxxxx tag (see .github/workflows/docker-image.yml)
IPHOTO_TAG=latest

# Host port the app is published on
IPHOTO_PORT=8080

# --- Nightly NAS backup (nas-backup/, iphoto-nas-backup service) ---
# Synology NAS reachable on the same LAN as this host. SSH there must work non-interactively with
# the key at NAS_SSH_KEY_HOST_PATH (see nas-backup/README.md for one-time setup on the NAS).
NAS_HOST=nas.local
NAS_USER=iphoto-backup
NAS_SSH_PORT=22
# Private key (not passphrase-protected - crond can't prompt for one) for NAS_USER, generated on
# the host and never committed - defaults to nas-backup/secrets/id_ed25519, gitignored.
NAS_SSH_KEY_HOST_PATH=./nas-backup/secrets/id_ed25519
# Remote paths on the NAS - created automatically on first run if they don't exist.
NAS_ASSETS_PATH=/volume1/iphoto-backup/assets
NAS_DB_DUMPS_PATH=/volume1/iphoto-backup/db-dumps
NAS_REPORTS_PATH=/volume1/iphoto-backup/reports
# How many days of nightly postgres dumps to keep, locally and on the NAS (photo/video assets are
# never deleted from the NAS regardless of this setting - only dumps are pruned).
DB_DUMP_RETENTION_DAYS=30
# Timezone the 02:00 backup schedule runs in (see nas-backup/crontab).
BACKUP_TZ=UTC
