<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Sync feature: the on-demand upload/garbage job runs as a WorkManager foreground job
         (see SyncWorker) so the OS doesn't kill it mid-sync; these are what that requires. No
         broad photo/media permission is needed since the folder is picked via SAF (Storage
         Access Framework), which grants access to only that one tree. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".IPhotoApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IPhoto"
        android:usesCleartextTraffic="true">
        <!-- self-hosted server URL is commonly a plain-http LAN address (e.g. http://192.168.x.x:8080) -->

        <!-- WorkManager's default App Startup auto-initializer must be disabled when the
             Application implements Configuration.Provider (IPhotoApplication does, to supply
             SyncWorkerFactory) - otherwise the default initializer races it and usually wins,
             silently initializing WorkManager with the plain-reflection default WorkerFactory
             instead. That factory can only construct a Worker via a (Context, WorkerParameters)
             constructor, which SyncWorker doesn't have (it also needs AppContainer) - the
             resulting NoSuchMethodException fails every sync job before SyncWorker.doWork() ever
             runs. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.IPhoto">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
